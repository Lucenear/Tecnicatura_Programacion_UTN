@baseUrl = http://localhost:8000

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Carlos",
  "apellido": "Lopez",
  "email": "carlos@foodstore.com",
  "celular": "1144556677",
  "password": "password123"
}

